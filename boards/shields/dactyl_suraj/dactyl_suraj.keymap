#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
                // LEFT HALF
                // R0: ESC 1 2 3 4 5
                &kp ESC    &kp N1      &kp N2      &kp N3      &kp N4      &kp N5

                // R1: TAB Q W E R T
                &kp TAB    &kp Q       &kp W       &kp E       &kp R       &kp T

                // R2: CAPS A S D F G
                &kp CAPS   &kp A       &kp S       &kp D       &kp F       &kp G

                // R3: LSHIFT Z X C V B
                &kp LSHFT  &kp Z       &kp X       &kp C       &kp V       &kp B

                // R4: LCTRL SQUOTE BSLASH HASH
                &kp LCTRL  &kp SQT     &kp BSLH    &kp HASH

                // R5: LGUI LALT SPACE
                &kp LGUI   &kp LALT    &kp SPACE


                // RIGHT HALF
                // R0: 6 7 8 9 0 BSPC DEL
                &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp BSPC   &kp DEL

                // R1: Y U I O P RET
                &kp Y       &kp U       &kp I       &kp O       &kp P       &kp RET

                // R2: H J K L / [ ]
                &kp H       &kp J       &kp K       &kp L       &kp FSLH    &kp LBKT   &kp RBKT

                // R3: N M , . ; UP `
                &kp N       &kp M       &kp COMMA   &kp DOT     &kp SEMI    &kp UP     &kp GRAVE

                // R4: - = LEFT DOWN RIGHT
                &kp MINUS   &kp EQUAL    &kp LEFT    &kp DOWN    &kp RIGHT

                // R5: SPACE RALT RCTRL
                &kp SPACE   &kp RALT     &kp RCTRL
            >;
        };
    };
};