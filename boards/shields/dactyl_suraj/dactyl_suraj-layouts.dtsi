/*
 * ZMK physical layout generated from "default_transform" position data.
 *
 * Units: key_physical_attrs takes (width, height, x, y, rotation, rx, ry)
 *   - width/height/x/y/rx/ry are in hundredths of a key unit (1u = 100)
 *   - rotation is in hundredths of a degree
 *
 * Source coordinates using eighths of a unit (e.g. 0.125u) were rounded
 * to the nearest integer after scaling — this only affects the visual
 * arrangement shown in layout tools, not electrical/matrix behavior.
 *
 * NOTE: this defines the *physical* key positions only. You still need a
 * kscan node + a matrix transform (or direct GPIO / matrix wiring) that
 * matches your actual PCB, and a keymap with one binding per key below.
 * Key count: 66 (13+12+13+13+9+6), listed row-major, matching the
 * row/col order of the source data.
 */

#include <physical_layouts.dtsi>

/ {

	default_transform: default_transform {
			compatible = "zmk,matrix-transform";

			rows = <6>;
			columns = <13>;

			map = <
				RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) 					RC(0,12) RC(0,11) RC(0,10) RC(0,9) RC(0,8) RC(0,7) RC(0,6)
				RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) 					RC(1,12) RC(1,11) RC(1,10) RC(1,9) RC(1,8) RC(1,7) 
				RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) 					RC(2,12) RC(2,11) RC(2,10) RC(2,9) RC(2,8) RC(2,7) RC(2,6)
				RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) 					RC(3,12) RC(3,11) RC(3,10) RC(3,9) RC(3,8) RC(3,7) RC(3,6)
				RC(4,0)	RC(4,1) RC(4,2) RC(4,3) RC(4,4)	RC(4,5)	   				    				  RC(4,10) RC(4,9) RC(4,8) RC(4,7) RC(4,6)
										RC(5,3) RC(5,4) RC(5,5)						RC(5,12) RC(5,11) RC(5,10)
			>;
		};

	default_layout: default_layout {
			compatible = "zmk,physical-layout";
			display-name = "Default Layout";
			transform = <&default_transform>;

			keys  //                     w    h    x    y    rot    rx    ry
				/* Row 0 */
				= <&key_physical_attrs 100  100    0   38     0     0    0>  // R0C0
				, <&key_physical_attrs 100  100  100   38     0     0    0>  // R0C1
				, <&key_physical_attrs 100  100  200   13     0     0    0>  // R0C2
				, <&key_physical_attrs 100  100  300    0     0     0    0>  // R0C3
				, <&key_physical_attrs 100  100  400   13     0     0    0>  // R0C4
				, <&key_physical_attrs 100  100  500   25     0     0    0>  // R0C5
				, <&key_physical_attrs 100  100  900   25     0     0    0>  // R0C7
				, <&key_physical_attrs 100  100 1000   13     0     0    0>  // R0C8
				, <&key_physical_attrs 100  100 1100    0     0     0    0>  // R0C9
				, <&key_physical_attrs 100  100 1200   13     0     0    0>  // R0C10
				, <&key_physical_attrs 100  100 1300   38     0     0    0>  // R0C11
				, <&key_physical_attrs 100  100 1400   38     0     0    0>  // R0C12
				, <&key_physical_attrs 100  100 1500   38     0     0    0>  // R0C13

				/* Row 1 */
				, <&key_physical_attrs 100  100    0  138     0     0    0>  // R1C0
				, <&key_physical_attrs 100  100  100  138     0     0    0>  // R1C1
				, <&key_physical_attrs 100  100  200  113     0     0    0>  // R1C2
				, <&key_physical_attrs 100  100  300  100     0     0    0>  // R1C3
				, <&key_physical_attrs 100  100  400  113     0     0    0>  // R1C4
				, <&key_physical_attrs 100  100  500  125     0     0    0>  // R1C5
				, <&key_physical_attrs 100  100  900  125     0     0    0>  // R1C7
				, <&key_physical_attrs 100  100 1000  113     0     0    0>  // R1C8
				, <&key_physical_attrs 100  100 1100  100     0     0    0>  // R1C9
				, <&key_physical_attrs 100  100 1200  113     0     0    0>  // R1C10
				, <&key_physical_attrs 100  100 1300  138     0     0    0>  // R1C11
				, <&key_physical_attrs 200  100 1400  138     0     0    0>  // R1C12 (2u wide)

				/* Row 2 */
				, <&key_physical_attrs 100  100    0  238     0     0    0>  // R2C0
				, <&key_physical_attrs 100  100  100  238     0     0    0>  // R2C1
				, <&key_physical_attrs 100  100  200  213     0     0    0>  // R2C2
				, <&key_physical_attrs 100  100  300  200     0     0    0>  // R2C3
				, <&key_physical_attrs 100  100  400  213     0     0    0>  // R2C4
				, <&key_physical_attrs 100  100  500  225     0     0    0>  // R2C5
				, <&key_physical_attrs 100  100  900  225     0     0    0>  // R2C7
				, <&key_physical_attrs 100  100 1000  213     0     0    0>  // R2C8
				, <&key_physical_attrs 100  100 1100  200     0     0    0>  // R2C9
				, <&key_physical_attrs 100  100 1200  213     0     0    0>  // R2C10
				, <&key_physical_attrs 100  100 1300  238     0     0    0>  // R2C11
				, <&key_physical_attrs 100  100 1400  238     0     0    0>  // R2C12
				, <&key_physical_attrs 100  100 1500  238     0     0    0>  // R2C13

				/* Row 3 */
				, <&key_physical_attrs 100  100    0  338     0     0    0>  // R3C0
				, <&key_physical_attrs 100  100  100  338     0     0    0>  // R3C1
				, <&key_physical_attrs 100  100  200  313     0     0    0>  // R3C2
				, <&key_physical_attrs 100  100  300  300     0     0    0>  // R3C3
				, <&key_physical_attrs 100  100  400  313     0     0    0>  // R3C4
				, <&key_physical_attrs 100  100  500  325     0     0    0>  // R3C5
				, <&key_physical_attrs 100  100  900  325     0     0    0>  // R3C7
				, <&key_physical_attrs 100  100 1000  313     0     0    0>  // R3C8
				, <&key_physical_attrs 100  100 1100  300     0     0    0>  // R3C9
				, <&key_physical_attrs 100  100 1200  313     0     0    0>  // R3C10
				, <&key_physical_attrs 100  100 1300  338     0     0    0>  // R3C11
				, <&key_physical_attrs 100  100 1400  338     0     0    0>  // R3C12
				, <&key_physical_attrs 100  100 1500  338     0     0    0>  // R3C13

				/* Row 4 */
				, <&key_physical_attrs 100  100    0  438     0     0    0>  // R4C0
				, <&key_physical_attrs 100  100  100  438     0     0    0>  // R4C1
				, <&key_physical_attrs 100  100  200  413     0     0    0>  // R4C2
				, <&key_physical_attrs 100  100  300  400     0     0    0>  // R4C3
				, <&key_physical_attrs 100  100  360  500     5     0    0>  // R4C4
				, <&key_physical_attrs 100  100  475  510    10     0    0>  // R4C5
				, <&key_physical_attrs 100  100 1100  400     0     0    0>  // R4C9
				, <&key_physical_attrs 100  100 1200  413     0     0    0>  // R4C10
				, <&key_physical_attrs 100  100 1300  438     0     0    0>  // R4C11
				, <&key_physical_attrs 100  100 1400  438     0     0    0>  // R4C12
				, <&key_physical_attrs 100  100 1500  438     0     0    0>  // R4C13

				/* Row 5 / Thumb cluster */
				, <&key_physical_attrs 100  100  348  600    10     0    0>  // R5C3
				, <&key_physical_attrs 100  100  410  613    15   398  790>  // R5C4
				, <&key_physical_attrs 100  150  468  463    30   398  790>  // R5C5
				, <&key_physical_attrs 100  150  952  463   (-30)  1102  790>  // R5C7
				, <&key_physical_attrs 100  100 1000  513   (-15)  1102  790>  // R5C8
				, <&key_physical_attrs 100  100 1052  513     0     0    0>  // R5C9
				;
		};
};